{
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${PLUGIN_ROOT}/hooks/auto_memory.py\" --capture",
            "commandWindows": "\"${PLUGIN_ROOT}\\bin\\reme-hook-launcher.exe\" --capture",
            "timeout": 5
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${PLUGIN_ROOT}/hooks/auto_memory.py\" --stop",
            "commandWindows": "\"${PLUGIN_ROOT}\\bin\\reme-hook-launcher.exe\" --stop",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
