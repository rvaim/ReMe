#!/bin/sh

plugin_root=${PLUGIN_ROOT:-${CLAUDE_PLUGIN_ROOT:-}}
if [ -z "$plugin_root" ]; then
    script_dir=$(CDPATH= cd -- "$(dirname -- "$0")" 2>/dev/null && pwd)
    plugin_root=$(dirname -- "$script_dir")
fi
hook="$plugin_root/hooks/reme_hook.py"
log_file="$HOME/.reme/log/reme-plugin.log"

write_log() {
    mkdir -p "$(dirname -- "$log_file")" 2>/dev/null || true
    printf '%s [launcher] %s\n' "$(date '+%Y-%m-%d %H:%M:%S' 2>/dev/null || printf unknown-time)" "$1" >> "$log_file" 2>/dev/null || true
}

probe_python() {
    "$@" -c 'import sys; raise SystemExit(0 if sys.version_info >= (3, 10) and sys.executable else 3)' >/dev/null 2>&1
}

if [ -n "${REME_PYTHON:-}" ] && probe_python "$REME_PYTHON"; then
    exec env PYTHONUTF8=1 PYTHONIOENCODING=utf-8 "$REME_PYTHON" "$hook" "$@"
fi
if [ -n "${REME_CODEX_PYTHON:-}" ] && probe_python "$REME_CODEX_PYTHON"; then
    exec env PYTHONUTF8=1 PYTHONIOENCODING=utf-8 "$REME_CODEX_PYTHON" "$hook" "$@"
fi
if command -v python3 >/dev/null 2>&1 && probe_python python3; then
    exec env PYTHONUTF8=1 PYTHONIOENCODING=utf-8 python3 "$hook" "$@"
fi
if command -v python >/dev/null 2>&1 && probe_python python; then
    exec env PYTHONUTF8=1 PYTHONIOENCODING=utf-8 python "$hook" "$@"
fi

write_log 'no usable Python 3.10+ interpreter found; tried REME_PYTHON, REME_CODEX_PYTHON, python3, python'
exit 0
